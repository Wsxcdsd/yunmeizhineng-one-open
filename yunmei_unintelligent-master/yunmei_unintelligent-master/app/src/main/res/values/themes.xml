<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Base application theme. -->
    <style name="Base.Theme.云梅不智能" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/titleBar_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >?attr/colorPrimaryVariant</item>

        <!-- ★ v6 蓝白精修：全部为全局样式层调整，不触碰任何布局结构 -->
        <!-- 柔和蓝白窗口背景（设置页/主界面统一生效） -->
        <item name="android:windowBackground">@color/bg_soft</item>
        <item name="android:colorBackground">@color/bg_soft</item>
        <!-- 文字改柔和深灰（开关/单选/说明文字自动继承），替代刺眼纯黑 -->
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <!-- 按钮与输入框统一 12dp 圆角（胶囊感），Material3 全局生效 -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.Rounded12</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Rounded12</item>
    </style>

    <!-- ★ v6：统一圆角形状 -->
    <style name="Shape.Rounded12" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <!-- ★ 新增：小部件点击后的隐形中转页主题。
         完全透明 + 无转场动画 + 不压暗背景，用户全程停留在桌面 -->
    <style name="Theme.UnlockInvisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>
</resources>
