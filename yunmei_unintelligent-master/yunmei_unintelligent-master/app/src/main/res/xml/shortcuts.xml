<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 共存版改动 2/2：targetPackage 从 cc.xypp.yunmeiui 改为 cc.xypp.yunmeiui.mod
     （包名改了之后静态快捷方式必须指向新包名，否则长按图标的"开锁/签到"会失效）
     其余与原版一致 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="unlock"
        android:enabled="true"
        android:icon="@drawable/ic_unlock"
        android:shortcutShortLabel="@string/unlockShortCut"
        android:shortcutLongLabel="@string/unlockShortCut"
        android:shortcutDisabledMessage="@string/unlockShortCutDisabled">
        <intent
            android:action="cc.xypp.yunmeiui.unlock"
            android:targetPackage="cc.xypp.yunmeiui.mod"
            android:targetClass="cc.xypp.yunmeiui.MainActivity"

            />
        <!-- If your shortcut is associated with multiple intents, include them
             here. The last intent in the list determines what the user sees when
             they launch this shortcut. -->
        <categories android:name="android.intent.category.LAUNCHER" />
    </shortcut>
    <shortcut
        android:shortcutId="sign"
        android:enabled="true"
        android:icon="@drawable/ic___"
        android:shortcutShortLabel="@string/signShortCut"
        android:shortcutLongLabel="@string/signShortCut"
        android:shortcutDisabledMessage="@string/signShortCutDisabled">
        <intent
            android:action="cc.xypp.yunmeiui.sign"
            android:targetPackage="cc.xypp.yunmeiui.mod"
            android:targetClass="cc.xypp.yunmeiui.MainActivity"

            />
        <!-- If your shortcut is associated with multiple intents, include them
             here. The last intent in the list determines what the user sees when
             they launch this shortcut. -->
        <categories android:name="android.intent.category.LAUNCHER" />
    </shortcut>
    <!-- Specify more shortcuts here. -->
</shortcuts>
